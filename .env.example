DATABASE_URL=postgresql://usuario:senha@host:5432/aao?schema=public
JWT_SECRET=gerar-string-aleatoria-longa
MASTER_ENCRYPTION_KEY=64 hex chars — openssl rand -hex 32
BRIDGE_URL=http://localhost:8100
BRIDGE_API_KEY=mesma-chave-do-bridge
BRIDGE_SHARED_DATA_DIR=/caminho/para/aao-hermes-bridge/data
MINIO_ENDPOINT=host-do-minio-ou-s3
MINIO_PORT=9000
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=aao-files
PORT=3000
CORS_ORIGIN=https://app.seudominio.com.br


# URL do frontend
FRONTEND_URL=https://app.seudominio.com.br

# --- Reuniões (bot aao-scribe) ---
# Redis compartilhado com o aao-scribe (filas BullMQ).
REDIS_URL=redis://localhost:6379
# Fila que o aao-scribe consome para entrar/gravar a reunião.
MEETING_QUEUE_NAME=meeting-bot
# Fila que o aao-scribe produz quando a transcrição está pronta.
MEETING_PROCESS_QUEUE_NAME=meeting-process
# Teto de reuniões simultâneas em andamento por empresa (anti-flood).
MEETING_MAX_CONCURRENT=5
# Login hospedado (aao-login): conectar a conta Google/Microsoft do escritório
# sem terminal. INTERNAL = aao-api → aao-login; PUBLIC_WS = painel (browser) →
# aao-login. Use wss:// em produção (atrás de TLS).
AAO_LOGIN_INTERNAL_URL=http://localhost:4000
AAO_LOGIN_PUBLIC_WS_URL=ws://localhost:4000

# IA da trilha (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Chamadas simultâneas à IA da trilha; o excesso espera a vez (padrão 20)
ANTHROPIC_MAX_CONCURRENCY=80
ANTHROPIC_PLAN_CONCURRENCY=40
